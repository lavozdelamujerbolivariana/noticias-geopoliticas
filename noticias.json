import json
import re
from datetime import datetime
import requests
from bs4 import BeautifulSoup

# Configuración de sesión con User-Agent
session = requests.Session()
session.headers.update({
    "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36"
})

def obtener_noticias_rss(url_rss):
    """Extrae entradas desde un Feed RSS estandarizado."""
    noticias = []
    try:
        response = session.get(url_rss, timeout=10)
        if response.status_code == 200:
            soup = BeautifulSoup(response.content, 'xml')
            items = soup.find_all('item')[:5]
            for item in items:
                link = item.link.text.strip() if item.link else ""
                titulo = item.title.text.strip() if item.title else ""
                
                # Filtrar enlaces que contengan años antiguos de forma explícita
                if link and titulo:
                    noticias.append({"titulo": titulo, "link": link})
    except Exception as e:
        print(f"Error procesando RSS {url_rss}: {e}")
    return noticias

def filtrar_noticias_recientes(lista_noticias, ano_actual="2026"):
    """Descarta enlaces con referencias explícitas a años anteriores."""
    filtradas = []
    for item in lista_noticias:
        # Si la URL contiene un año de 4 dígitos anterior al actual, se omite
        anos_viejos = [str(a) for a in range(2010, int(ano_actual))]
        if not any(f"/{ano}/" in item["link"] for ano in anos_viejos):
            filtradas.append(item)
    return filtradas
